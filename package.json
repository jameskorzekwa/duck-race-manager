{
  "name": "duck-race-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply quickducks-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply quickducks-prod --remote",
    "test": "node --test src/index.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
