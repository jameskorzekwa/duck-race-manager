{
  "name": "duck-race-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply quickducks-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply quickducks-prod --remote",
    "test": "node --test src/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1095.0",
    "aws-jwt-verify": "^5.2.1"
  }
}
