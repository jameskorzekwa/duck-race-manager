{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickducks",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ORIGIN": "https://quickducks.com",
    "AWS_REGION": "us-east-1",
    "EMAIL_FROM_ADDRESS": "race@quickducks.com",
    "COGNITO_USER_POOL_ID": "REPLACE_AFTER_AWS_DEPLOY",
    "COGNITO_USER_POOL_CLIENT_ID": "REPLACE_AFTER_AWS_DEPLOY",
    "COGNITO_DOMAIN": "REPLACE_AFTER_AWS_DEPLOY"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickducks-prod",
      "database_id": "REPLACE_AFTER_D1_CREATE",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DUCK_PHOTOS",
      "bucket_name": "quickducks-duck-photos"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RACE_UPDATES",
        "class_name": "RaceUpdates"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaceUpdates"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "quickducks-email"
      }
    ],
    "consumers": [
      {
        "queue": "quickducks-email",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "quickducks-email-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "ratelimits": [
    {
      "name": "PARTICIPANT_CONTACT_READ_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_SEARCH_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "quickducks.com",
      "custom_domain": true
    },
    {
      "pattern": "www.quickducks.com",
      "custom_domain": true
    }
  ]
}
