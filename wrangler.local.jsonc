// Local development only. `npm run dev:local` uses this config; deployment never
// does. It differs from wrangler.jsonc in the ways that make the site runnable
// with no network access:
//
//   1. `main` is src/local-dev.ts, which supplies an offline stand-in for the
//      Cognito hosted UI and token endpoints.
//   2. `APP_ORIGIN` is a local address, which is the single switch every
//      local-preview affordance in the Worker keys off. `npm run dev:network`
//      overrides it with the network address it serves on.
//   3. `COGNITO_DOMAIN` points back at the local Worker so the OAuth redirects
//      resolve locally. It must stay a valid absolute URL: staff pages parse it
//      to build their CSP form-action.
//   4. Every resource identity is local. The Worker name, D1 database, and queue
//      are all distinct from production, and no route, workers.dev subdomain, or
//      preview URL is published.
//
// Point 4 is the important one. `src/local-dev.ts` hands out an administrator
// bearer token to anyone who asks, which is safe only because the data behind it
// is a throwaway local database. Binding a real resource here — by copying an id
// from wrangler.jsonc, or by reaching for `--remote` — would put that endpoint in
// front of production data. The local entry point also refuses any request that
// did not arrive on the origin it was configured for, so both mistakes fail
// closed.
//
// The binding *shapes* must stay identical to production, because that is what
// Wrangler simulates. Dropping the rate limiter in particular would make the
// public search and My Ducks routes throw: `src/api.ts` reads it with no
// undefined guard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickducks-local",
  "main": "src/local-dev.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "AWS_REGION": "us-east-1",
    "EMAIL_FROM_ADDRESS": "race@quickducks.local",
    "COGNITO_USER_POOL_ID": "us-east-1_local0000",
    "COGNITO_USER_POOL_CLIENT_ID": "localdevclientid",
    "COGNITO_DOMAIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickducks-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RACE_UPDATES",
        "class_name": "RaceUpdates"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaceUpdates"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "quickducks-email-local"
      }
    ],
    "consumers": [
      {
        "queue": "quickducks-email-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "quickducks-email-local-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_SEARCH_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
